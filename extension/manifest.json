{
  "manifest_version": 3,

  "name": "Semantic Filter",

  "version": "1.0",

  "description": "AI-powered semantic filtering",

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "https://www.youtube.com/*",
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*"
  ],

  "action": {
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],

      "js": [
        "content.js"
      ],

      "css": [
        "styles.css"
      ]
    }
  ]
}